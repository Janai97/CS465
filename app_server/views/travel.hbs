{{> header}}

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h1 class="m-0">Travel</h1>

    <!-- Optional: search bar placeholder (wireframe mentions it) -->
    <form method="get" action="/travel" class="d-flex gap-2">
      <input
        type="text"
        name="q"
        class="form-control"
        placeholder="Search travel"
        value="{{query}}"
        style="max-width: 260px;"
      />
      <button class="btn btn-outline-primary" type="submit">Search</button>
    </form>
  </div>

  <hr />

  <div class="row g-3">
    {{#each trips}}
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 trip-card">

          <!-- ✅ uniform image sizing handled by CSS class -->
          <img
            class="trip-card-img"
            src="/images/{{this.image}}"
            alt="{{this.name}}"
          />

          <div class="card-body d-flex flex-column">
            <h5 class="card-title">{{this.name}}</h5>

            <div class="small text-muted">
              <div><strong>ID:</strong> {{this.code}}</div>
              <div><strong>Length:</strong> {{this.length}}</div>
              <div><strong>Start:</strong> {{this.start}}</div>
              <div><strong>Resort:</strong> {{this.resort}}</div>
              <div><strong>Per Person:</strong> ${{this.perPerson}}</div>
            </div>

            <div class="mt-2" style="flex: 1 1 auto;">
              {{{this.description}}}
            </div>

            <form method="post" action="/travel/add-to-cart" class="mt-3">
              <input type="hidden" name="tripCode" value="{{this.code}}" />
              <button type="submit" class="btn btn-primary w-100">
                Add to Cart
              </button>
            </form>
          </div>

        </div>
      </div>
    {{/each}}

    {{#unless trips.length}}
      <div class="col-12">
        <div class="alert alert-warning">No trips available.</div>
      </div>
    {{/unless}}
  </div>
</div>

{{> footer}}